// ============================================================
//  STRUCTURE : INSTITUTS, ACCÈS, ANNÉES, PARAMÈTRES
//  (domaines, filières et classes : voir academique.prisma)
// ============================================================

// Un institut = un établissement ou un site. C'est le « locataire » du logiciel :
// presque toutes les données portent un institut_id, ce qui isole les instituts entre eux.
model Institut {
  id           Int       @id @default(autoincrement())
  code         String    @unique @db.VarChar(20)
  nom          String    @db.VarChar(150)
  sigle        String?   @db.VarChar(20)
  adresse      String?   @db.VarChar(255) // imprimée sur la fiche : « Lieu d'inscription »
  telephone    String?   @db.VarChar(30)
  telephone2   String?   @map("telephone_2") @db.VarChar(30)
  email        String?   @db.VarChar(150)
  // Logo : adresse publique + clé du fichier dans le stockage (Cloudinary aujourd'hui, R2 en B5b)
  logoUrl      String?   @map("logo_url") @db.VarChar(500)
  logoIdPublic String?   @map("logo_id_public") @db.VarChar(200)
  estPrincipal Boolean   @default(false) @map("est_principal")
  actif        Boolean   @default(true)
  creeLe       DateTime  @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe    DateTime  @updatedAt @map("modifie_le") @db.Timestamptz(3)
  supprimeLe   DateTime? @map("supprime_le") @db.Timestamptz(3)

  utilisateurs       Utilisateur[]
  accesInstituts     AccesInstitut[]
  anneesScolaires    AnneeScolaire[]
  parametres         Parametre[]
  domaines           Domaine[]
  filieres           Filiere[]
  classes            Classe[]
  etudiants          Etudiant[]
  inscriptions       Inscription[]
  frais              Frais[]
  tauxChange         TauxChange[]
  paiements          Paiement[]
  sequencesMatricule SequenceMatricule[]

  @@map("instituts")
}

// Instituts auxquels un utilisateur a accès (surtout le DG, qui en gère plusieurs).
model AccesInstitut {
  utilisateurId String   @map("utilisateur_id") @db.Uuid
  institutId    Int      @map("institut_id")
  creeLe        DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  institut    Institut    @relation(fields: [institutId], references: [id], onDelete: Cascade)

  @@id([utilisateurId, institutId])
  @@index([institutId])
  @@map("acces_instituts")
}

// L'année scolaire est PROPRE À CHAQUE INSTITUT : clôturer 2026-2027 dans un institut
// ne touche jamais l'année d'un autre.
model AnneeScolaire {
  id          Int       @id @default(autoincrement())
  institutId  Int       @map("institut_id")
  libelle     String    @db.VarChar(9) // "2026-2027"
  dateDebut   DateTime  @map("date_debut") @db.Date
  dateFin     DateTime  @map("date_fin") @db.Date
  estActive   Boolean   @default(false) @map("est_active")
  estCloturee Boolean   @default(false) @map("est_cloturee")
  clotureLe   DateTime? @map("cloture_le") @db.Timestamptz(3)
  creeLe      DateTime  @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe   DateTime  @updatedAt @map("modifie_le") @db.Timestamptz(3)

  institut           Institut            @relation(fields: [institutId], references: [id])
  inscriptions       Inscription[]
  statutsAnnuels     StatutAnnuel[]
  frais              Frais[]
  paiements          Paiement[]
  sequencesMatricule SequenceMatricule[]

  @@unique([institutId, libelle])
  @@map("annees_scolaires")
}

// Réglages clé / valeur PAR INSTITUT (format du matricule, seuils...).
model Parametre {
  id          Int      @id @default(autoincrement())
  institutId  Int      @map("institut_id")
  cle         String   @db.VarChar(80)
  valeur      Json
  description String?  @db.VarChar(255)
  modifiePar  String?  @map("modifie_par") @db.Uuid
  modifieLe   DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  institut Institut @relation(fields: [institutId], references: [id])

  @@unique([institutId, cle])
  @@map("parametres")
}